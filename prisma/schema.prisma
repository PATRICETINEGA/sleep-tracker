generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  sleeps    Sleep[]
  createdAt DateTime @default(now())
}

model Sleep {
  id        String   @id @default(cuid())
  hours     Float
  quality   String?  // good | okay | poor
  date      String   // YYYY-MM-DD
  notes     String?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
}
